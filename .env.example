# The CLI reads exported environment variables; it does not load .env files.
VLM_EVAL_BASE_URL=http://127.0.0.1:11434
# Optional for HTTPS, or a llama.cpp server on literal loopback HTTP:
# VLM_EVAL_API_KEY=replace-with-your-key

# Hosted OpenAI only; export securely. No endpoint override is supported.
# OPENAI_API_KEY=replace-with-your-openai-api-key
# The OpenAI provider ignores VLM_EVAL_BASE_URL and VLM_EVAL_API_KEY.
